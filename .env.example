# Resend (https://resend.com) - used to send the "Pedir Orçamento" form emails
RESEND_API_KEY=

# Optional: sender address once a custom domain is verified on Resend.
# Defaults to onboarding@resend.dev (Resend's shared sandbox domain) if unset.
# The display name "Orçamentos C&P" is fixed in code either way.
RESEND_FROM_EMAIL=

# Vercel Blob (Storage -> Create Database -> Blob in the Vercel dashboard)
# Automatically provided by Vercel when the project is linked to a Blob store;
# only needed manually for local development.
BLOB_READ_WRITE_TOKEN=
